<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="@color/surface_card"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Predictions &amp; AI Research"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/brand_emerald" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corpus collection &amp; personal dictionary"
                android:textSize="12sp"
                android:textColor="@color/text_sub" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- Card 1: Hmar AI Research Corpus -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HMAR AI TRAINING CORPUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/brand_emerald" />

                <TextView
                    android:id="@+id/tv_sentence_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Sentences Buffered"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_emerald"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complete conversational sentences (> 3 words) are captured locally on your device for Hmar language models and research. Passwords, PINs, and OTPs are never recorded."
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btn_export_dataset"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Export Dataset (.jsonl)"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="@color/brand_emerald"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

            <!-- Card 2: Personalized User Dictionary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERSONALIZED USER DICTIONARY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/brand_emerald" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_unigram_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_emerald" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Learned Words"
                            android:textSize="12sp"
                            android:textColor="@color/text_sub" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_bigram_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/brand_emerald" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Word Transitions"
                            android:textSize="12sp"
                            android:textColor="@color/text_sub" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stored permanently in on-device SQLite so your keyboard remembers custom names, slang, and your frequent phrase patterns across app updates."
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/btn_manage_dictionary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Manage Personal Dictionary →"
                    android:textColor="@color/brand_emerald"
                    android:background="@drawable/badge_active"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- Card 3: Storage & Privacy Management -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRIVACY &amp; DATA MANAGEMENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/brand_emerald" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You have full control over your local typing data. Clearing data will reset your learned dictionary and erase buffered sentences from this phone."
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="8dp" />

                <Button
                    android:id="@+id/btn_clear_data"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Clear Typing History &amp; Dictionary"
                    android:textColor="#C0392B"
                    android:backgroundTint="#FADBD8"
                    android:layout_marginTop="16dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
