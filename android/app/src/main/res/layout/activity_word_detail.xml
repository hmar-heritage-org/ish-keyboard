<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_card"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btn_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tv_title_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Word Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brand_emerald" />

        <TextView
            android:id="@+id/btn_save_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Word Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_hero_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="word"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_emerald" />

                <!-- Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/badge_ish_standard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_active"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="ISH Baseline"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_active_text"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/badge_custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_custom"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Personal Word"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_active_text"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/badge_usage_freq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_freq"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Not typed yet"
                        android:textSize="11sp"
                        android:textColor="@color/text_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: Word Spelling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WORD SPELLING"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/brand_emerald"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit the capitalization or spelling of this word for keyboard predictions."
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/et_word_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_bg"
                    android:padding="14dp"
                    android:textSize="16sp"
                    android:textColor="@color/text_main"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tv_usage_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Usage: Typed 5 times"
                    android:textSize="12sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Card: Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_delete_word_full"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Delete Word from Dictionary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:background="@drawable/btn_secondary"
                    app:backgroundTint="@null"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
